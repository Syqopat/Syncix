# What does NOT go into the package.
# Dependencies are bundled into out/extension.js by build.js, so node_modules
# is excluded further below. Before bundling, 'ws' once dropped out of the package
# and the extension never opened ("Cannot find module 'ws'"); that only showed up
# on a clean install, never on the developer's machine.
.vscode/**
src/**
out/**/*.map
tsconfig.json
**/*.ts
!out/**/*.js
.gitignore
node_modules/.bin/**
node_modules/**/test/**
node_modules/**/*.md

# SVGs do NOT go into the package.
# vsce refuses to publish extensions containing user-provided SVG images
# ("Due to security concerns, vsce will not publish extensions that contain
# user-provided SVG images"). They stay in the repository as sources; the PNG
# versions go into the package.
resources/*.svg

# node_modules does NOT go into the package.
# Dependencies are bundled into out/extension.js by build.js,
# so they do not need to ship separately.
node_modules/**
build.js

# A stray copy of the core in bin/ went into the package as a second 5 MB exe.
# The extension runs resources/bin/<platform>-<arch>/, and the terminal command
# lives in the extension's global storage, so nothing reads bin/.
bin/**
